      ],
      "row0_contains": [
        "Cloakroom",
        "Score: 0",
        "Moves: 1"
      ],
      "row0_reverse": true,
      "expect": "v7/v8 use the v5 screen model (§1): the same reverse-video status line"
    },
    {
      "id": "save-restore-per-target",
      "suite": "v2",
      "type": "save_restore",
      "targets": [
        7,
        8
      ],
