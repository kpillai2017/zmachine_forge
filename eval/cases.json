    {
      "id": "reject-below-v5",
      "suite": "v2",
      "type": "reject_cli",
      "version_byte": 3,
      "exit_code": 2,
      "expect": "Unsupported story version 3: zforge runs versions 5, 7 and 8"
    },
    {
      "id": "illegal-opcode-per-version",
      "suite": "v2",
      "type": "illegal_opcode",
      "targets": [
