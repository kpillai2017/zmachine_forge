# zbuilder (the agent workflow) - pick ONE provider, or leave all blank for
# offline "brief" mode (writes task briefs + verifies; never calls a model).
# ZB_PROVIDER=rovodev            # rovodev | anthropic | openai | gemini | ollama | brief
# ROVODEV_SERVE_URL=http://localhost:8123   # acli rovodev serve 8123 --disable-session-token
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=              # any OpenAI-compatible endpoint
# GEMINI_API_KEY=
# OLLAMA_HOST=http://localhost:11434
# ZB_MODEL=                     # override the provider's default model
# ZB_MAX_CALLS=60               # LLM call budget per build run
#
# zforge (the product) never uses any of these.
